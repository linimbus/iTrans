<Window x:Class="Itrans.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="itrans 截图翻译"
        Icon="Assets/itrans-256.png"
        Width="350"
        Height="600"
        MinWidth="200"
        MinHeight="100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="16,14,16,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="30" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
            <Button Content="复制原文" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="CopyOcr_Click" />
            <Button Content="文件翻译" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0" Click="FileTranslate_Click" />
            <Button Content="设置" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0" Click="Settings_Click" />
            <Button x:Name="CaptureButton" Content="截图翻译" Style="{StaticResource PrimaryButton}" Padding="16,7" Click="Capture_Click" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <TextBox x:Name="OcrTextBox"
                     Style="{StaticResource EditorBox}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </Border>

        <GridSplitter Grid.Row="2"
                      Height="12"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="False"
                      Cursor="SizeNS">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent" Height="12">
                        <Border x:Name="Line"
                                Height="1"
                                Background="{StaticResource LineBrush}"
                                VerticalAlignment="Center"
                                Margin="4,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Background" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <Border Grid.Row="3" Style="{StaticResource Card}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock x:Name="DirectionText"
                               Text="自动检测"
                               FontSize="11"
                               Foreground="{StaticResource SubtleBrush}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="重新翻译" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Click="Retranslate_Click" />
                        <Button Content="复制译文" Style="{StaticResource GhostButton}" Click="CopyTranslation_Click" />
                    </StackPanel>
                </Grid>
                <TextBox x:Name="TranslationTextBox"
                         Style="{StaticResource EditorBox}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText"
                       Text="就绪"
                       FontSize="11.5"
                       Foreground="{StaticResource SubtleBrush}"
                       VerticalAlignment="Center" />
            <Ellipse x:Name="ServiceDot"
                     Width="9"
                     Height="9"
                     Fill="#9CA3AF"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
