<Window x:Class="Itrans.SelectionTranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Itrans.Localization"
        Title="{loc:Loc selection.title}"
        Icon="Assets/itrans-256.png"
        Width="520"
        Height="440"
        MinWidth="360"
        MinHeight="240"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="10,8,10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="60" />
            <RowDefinition Height="*" MinHeight="60" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 划词原文 -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="{loc:Loc selection.original}"
                               Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ToggleButton AutomationProperties.Name="{loc:Loc common.pin}"
                                      Style="{StaticResource PinButton}"
                                      Margin="0,0,4,0"
                                      ToolTip="{loc:Loc common.pinTooltip}"
                                      IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                        <Button Content="{loc:Loc main.copySource}"
                                Style="{StaticResource GhostButton}"
                                Margin="0,0,4,0"
                                Click="CopyOriginal_Click" />
                        <Button Content="{loc:Loc main.retranslate}"
                                Style="{StaticResource GhostButton}"
                                Click="Retranslate_Click" />
                    </StackPanel>
                </Grid>
                <TextBox x:Name="OriginalBox"
                         Style="{StaticResource EditorBox}"
                         Padding="2"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         LostKeyboardFocus="OriginalBox_LostKeyboardFocus" />
            </DockPanel>
        </Border>

        <!-- 划词译文 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,6,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="{loc:Loc selection.translation}"
                               Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="DirectionText"
                               Text="{loc:Loc main.directionAuto}"
                               FontSize="10.5"
                               Foreground="{StaticResource SubtleBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Button Content="{loc:Loc main.copyTranslation}"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Right"
                            Click="CopyTranslation_Click" />
                </Grid>
                <TextBox x:Name="TranslationBox"
                         Style="{StaticResource EditorBox}"
                         Padding="2"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>

        <!-- 状态栏与服务健康状态 -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <TextBlock x:Name="StatusText"
                       FontSize="10.5"
                       Foreground="{StaticResource SubtleBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Ellipse x:Name="ServiceDot"
                     Width="8"
                     Height="8"
                     Fill="#9CA3AF"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
