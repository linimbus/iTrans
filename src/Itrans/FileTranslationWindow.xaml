<Window x:Class="Itrans.FileTranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Itrans.Localization"
        Title="{loc:Loc file.title}"
        Icon="Assets/itrans-256.png"
        Width="620"
        Height="460"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="12,10,12,10">
        <!-- 行结构：标题 / 翻译选项 / 文件列表 / 进度状态 / 底部操作栏 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 窗口标题与当前服务地址 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock Text="{loc:Loc file.header}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton AutomationProperties.Name="{loc:Loc common.pin}"
                              Style="{StaticResource PinButton}"
                              Margin="0,0,8,0"
                              ToolTip="{loc:Loc common.pinTooltip}"
                              IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                <Ellipse x:Name="ServiceDot"
                         Width="8"
                         Height="8"
                         Fill="#9CA3AF"
                         VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- 翻译选项：翻译方向与译文保存路径并列显示 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc file.sourceLanguage}"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,4" />
                                <ComboBox x:Name="SourceBox"
                                          Height="30"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Code"
                                          VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Loc file.targetLanguage}"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,4" />
                                <ComboBox x:Name="TargetBox"
                                          Height="30"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Code"
                                          VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:Loc file.outputDir}"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputDirBox"
                                     Style="{StaticResource EditorBox}"
                                     Height="30"
                                     Padding="2"
                                     VerticalContentAlignment="Center"
                                     LostFocus="OutputDirBox_LostFocus"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <Button x:Name="BrowseButton"
                                    Content="{loc:Loc common.browse}"
                                    Style="{StaticResource SecondaryButton}"
                                    Grid.Column="1"
                                    Padding="8,4"
                                    Margin="6,0,0,0"
                                    Click="Browse_Click" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 待翻译文件列表，支持拖拽外部文件添加，空列表时显示提示文字 -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="6"
                Margin="0,0,0,6"
                AllowDrop="True"
                DragOver="FileList_DragOver"
                Drop="FileList_Drop">
            <Grid>
                <ListView x:Name="FileList"
                          BorderThickness="0"
                          Background="Transparent"
                          AllowDrop="True"
                          DragOver="FileList_DragOver"
                          Drop="FileList_Drop"
                          MouseDoubleClick="FileList_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn x:Name="FileNameColumn" Width="300" DisplayMemberBinding="{Binding FileName}" />
                            <GridViewColumn x:Name="FileSizeColumn" Width="70" DisplayMemberBinding="{Binding SizeText}" />
                            <GridViewColumn x:Name="FileStatusColumn" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding StatusBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Status}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="EmptyHint"
                           Text="{loc:Loc file.emptyHint}"
                           FontSize="11"
                           Foreground="{StaticResource SubtleBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>
        </Border>

        <!-- 进度条与状态信息，仅在翻译过程中显示进度条 -->
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar x:Name="BusyBar"
                         Height="3"
                         Margin="0,0,0,4"
                         IsIndeterminate="True"
                         Visibility="Collapsed"
                         Foreground="{StaticResource AccentBrush}"
                         Background="#E3E7EF"
                         BorderThickness="0" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           FontSize="10.5"
                           Foreground="{StaticResource SubtleBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <TextBlock x:Name="ProgressText"
                           Grid.Column="1"
                           FontSize="10.5"
                           Foreground="{StaticResource SubtleBrush}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <!-- 底部操作栏：左侧文件管理按钮，右侧开始或取消翻译 -->
        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddButton"
                        Content="{loc:Loc file.add}"
                        Style="{StaticResource SecondaryButton}"
                        Padding="10,5"
                        Margin="0,0,6,0"
                        Click="AddFiles_Click" />
                <Button x:Name="RemoveButton"
                        Content="{loc:Loc file.remove}"
                        Style="{StaticResource GhostButton}"
                        Margin="0,0,2,0"
                        Click="RemoveSelected_Click" />
                <Button x:Name="ClearButton"
                        Content="{loc:Loc file.clear}"
                        Style="{StaticResource GhostButton}"
                        Click="Clear_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="{loc:Loc common.cancel}"
                        Style="{StaticResource SecondaryButton}"
                        Width="88"
                        Padding="10,5"
                        Margin="0,0,6,0"
                        IsEnabled="False"
                        Click="Cancel_Click" />
                <Button x:Name="StartButton"
                        Content="{loc:Loc file.start}"
                        Style="{StaticResource PrimaryButton}"
                        Width="88"
                        Padding="14,5"
                        Click="Start_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
