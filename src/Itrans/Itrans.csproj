<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AssemblyName>Itrans</AssemblyName>
    <RootNamespace>Itrans</RootNamespace>
    <Version>1.5.1</Version>
    <Product>itrans 截图翻译</Product>
    <Description>Windows 截图 OCR 翻译与文件翻译工具</Description>
    <ApplicationIcon>Assets\itrans.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- 只保留中文（简体）与英文资源，去掉不需要的本地化附属程序集 -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="System.Speech" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\itrans.ico" />
    <None Remove="Assets\itrans-256.png" />
    <Resource Include="Assets\itrans.ico" />
    <Resource Include="Assets\itrans-256.png" />
    <EmbeddedResource Include="Localization\*.json" />
  </ItemGroup>

</Project>
