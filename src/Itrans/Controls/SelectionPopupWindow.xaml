<Window x:Class="Itrans.Controls.SelectionPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Itrans.Localization"
        Width="84"
        Height="38"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        WindowStartupLocation="Manual">
    <Border Margin="4"
            Background="#FFFFFF"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="7">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" Color="#000000" />
        </Border.Effect>
        <Button Content="{loc:Loc selection.popup}"
                Style="{StaticResource PrimaryButton}"
                Padding="0"
                Margin="0"
                Click="Translate_Click" />
    </Border>
</Window>
