<Window x:Class="Itrans.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Itrans.Localization"
        xmlns:controls="clr-namespace:Itrans.Controls"
        Title="{loc:Loc settings.title}"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <!-- 标题 -->
            <TextBlock Text="{loc:Loc settings.header}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />

            <!-- 界面语言 -->
            <TextBlock Text="{loc:Loc settings.uiLanguage}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="UiLanguageBox"
                      Height="28"
                      DisplayMemberPath="NativeName"
                      SelectedValuePath="Code"
                      VerticalContentAlignment="Center"
                      Margin="0,0,0,10" />

            <!-- 服务配置：LibreTranslate 地址与可选 API Key -->
            <TextBlock Text="{loc:Loc settings.serverUrl}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="ServerUrlBox" Style="{StaticResource CompactEditorBox}" Margin="0,0,0,10" />

            <TextBlock Text="{loc:Loc settings.apiKey}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="ApiKeyBox" Style="{StaticResource CompactEditorBox}" Margin="0,0,0,10" />

            <!-- 文件翻译超时设置 -->
            <TextBlock Text="{loc:Loc settings.fileTimeout}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="FileTimeoutBox" Style="{StaticResource CompactEditorBox}" />
            <TextBlock Text="{loc:Loc settings.fileTimeoutHint}" Style="{StaticResource HintText}" />

            <!-- 快捷键：2x2 布局，支持按键监听 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.hotkey}" Style="{StaticResource FieldLabel}" />
                    <controls:HotkeyTextBox x:Name="HotkeyBox"
                                            Style="{StaticResource CompactEditorBox}"
                                            ToolTip="{loc:Loc settings.hotkeyCaptureHint}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{loc:Loc settings.fileHotkey}" Style="{StaticResource FieldLabel}" />
                    <controls:HotkeyTextBox x:Name="FileHotkeyBox"
                                            Style="{StaticResource CompactEditorBox}"
                                            ToolTip="{loc:Loc settings.hotkeyCaptureHint}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock Text="{loc:Loc settings.audioHotkey}" Style="{StaticResource FieldLabel}" />
                    <controls:HotkeyTextBox x:Name="AudioHotkeyBox"
                                            Style="{StaticResource CompactEditorBox}"
                                            ToolTip="{loc:Loc settings.hotkeyCaptureHint}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                    <TextBlock Text="{loc:Loc settings.settingsHotkey}" Style="{StaticResource FieldLabel}" />
                    <controls:HotkeyTextBox x:Name="SettingsHotkeyBox"
                                            Style="{StaticResource CompactEditorBox}"
                                            ToolTip="{loc:Loc settings.hotkeyCaptureHint}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{loc:Loc settings.hotkeysHint}" Style="{StaticResource HintText}" />

            <!-- OCR 识别语种，至少选择一种 -->
            <TextBlock Text="{loc:Loc settings.ocrLangs}" Style="{StaticResource FieldLabel}" />
            <WrapPanel Margin="0,0,0,2">
                <CheckBox x:Name="OcrSimplifiedBox" Content="{loc:Loc settings.ocrSimplified}" Margin="0,0,16,0" VerticalContentAlignment="Center" />
                <CheckBox x:Name="OcrTraditionalBox" Content="{loc:Loc settings.ocrTraditional}" Margin="0,0,16,0" VerticalContentAlignment="Center" />
                <CheckBox x:Name="OcrEnglishBox" Content="{loc:Loc settings.ocrEnglish}" VerticalContentAlignment="Center" />
            </WrapPanel>
            <TextBlock Text="{loc:Loc settings.ocrHint}" Style="{StaticResource HintText}" />

            <!-- 翻译方向：源语言与目标语言 -->
            <TextBlock Text="{loc:Loc settings.translationDirection}" Style="{StaticResource FieldLabel}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.sourceLanguage}"
                               Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="SourceLanguageBox"
                              Height="28"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Code"
                              VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{loc:Loc settings.targetLanguage}"
                               Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="TargetLanguageBox"
                              Height="28"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Code"
                              VerticalContentAlignment="Center" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{loc:Loc settings.translationHint}" Style="{StaticResource HintText}" />

            <!-- 内容字体与字号，作用于原文及译文文本框 -->
            <TextBlock Text="{loc:Loc settings.contentFont}" Style="{StaticResource FieldLabel}" />
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="FontFamilyBox"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          Height="28"
                          Margin="0,0,8,0"
                          VerticalContentAlignment="Center" />
                <ComboBox x:Name="FontSizeBox"
                          Grid.Column="1"
                          IsEditable="True"
                          Height="28"
                          VerticalContentAlignment="Center" />
            </Grid>
            <TextBlock Text="{loc:Loc settings.fontHint}" Style="{StaticResource HintText}" />

            <!-- 开机启动选项 -->
            <TextBlock Text="{loc:Loc settings.startup}" Style="{StaticResource FieldLabel}" />
            <CheckBox x:Name="AutoStartBox" Content="{loc:Loc settings.autoStart}" Margin="0,0,0,4" VerticalContentAlignment="Center" />
            <TextBlock Text="{loc:Loc settings.autoStartHint}" Style="{StaticResource HintText}" />

            <!-- 默认服务地址提示 -->
            <Border Background="#FFF7E6" CornerRadius="6" Padding="8,6" Margin="0,2,0,0">
                <TextBlock Text="{loc:Loc settings.serverHint}"
                           TextWrapping="Wrap"
                           Foreground="#92400E"
                           FontSize="10.5" />
            </Border>

            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" />

            <!-- 底部按钮：测试连接、保存、取消 -->
            <DockPanel Margin="0,12,0,0" LastChildFill="False">
                <Button x:Name="TestButton" Content="{loc:Loc settings.testConnection}" Style="{StaticResource SecondaryButton}" Click="TestConnection_Click" DockPanel.Dock="Left" />
                <Button Content="{loc:Loc common.save}" Style="{StaticResource PrimaryButton}" Width="84" IsDefault="True" Margin="8,0,0,0" Click="Save_Click" DockPanel.Dock="Right" />
                <Button Content="{loc:Loc common.cancel}" Style="{StaticResource SecondaryButton}" Width="76" IsCancel="True" Margin="8,0,0,0" Click="Cancel_Click" DockPanel.Dock="Right" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
