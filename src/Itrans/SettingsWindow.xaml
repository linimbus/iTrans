<Window x:Class="Itrans.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <!-- 标题 -->
            <TextBlock Text="偏好设置" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />

            <!-- 服务配置：LibreTranslate 地址与可选 API Key -->
            <TextBlock Text="LibreTranslate 服务地址" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="ServerUrlBox" Style="{StaticResource EditorBox}" Margin="0,0,0,10" />

            <TextBlock Text="API Key（可选）" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="ApiKeyBox" Style="{StaticResource EditorBox}" Margin="0,0,0,10" />

            <!-- 文件翻译超时设置 -->
            <TextBlock Text="文件翻译超时（秒）" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="FileTimeoutBox" Style="{StaticResource EditorBox}" />
            <TextBlock Text="范围 30–3600 秒，默认 600。超时后该文件标记为失败，可增大此值后重试。" Style="{StaticResource HintText}" />

            <!-- 截图快捷键 -->
            <TextBlock Text="截图快捷键" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="HotkeyBox" Style="{StaticResource EditorBox}" />
            <TextBlock Text="格式示例：Ctrl+Alt+Q。支持 A-Z、0-9、F1-F12 等主键，修改后立即生效。" Style="{StaticResource HintText}" />

            <!-- OCR 识别语种，至少选择一种 -->
            <TextBlock Text="OCR 识别语种" Style="{StaticResource FieldLabel}" />
            <WrapPanel Margin="0,0,0,4">
                <CheckBox x:Name="OcrSimplifiedBox" Content="简体中文" Margin="0,0,16,0" VerticalContentAlignment="Center" />
                <CheckBox x:Name="OcrTraditionalBox" Content="繁体中文" Margin="0,0,16,0" VerticalContentAlignment="Center" />
                <CheckBox x:Name="OcrEnglishBox" Content="English" VerticalContentAlignment="Center" />
            </WrapPanel>
            <TextBlock Text="至少勾选一种。中文引擎同时支持中英文混排；需先在 Windows 设置中安装对应语言的“光学字符识别”功能。" Style="{StaticResource HintText}" />

            <!-- 翻译方向 -->
            <TextBlock Text="翻译方向" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="TranslationModeBox"
                      Height="30"
                      SelectedValuePath="Tag"
                      VerticalContentAlignment="Center"
                      Margin="0,0,0,4">
                <ComboBoxItem Content="自动检测（中文 ⇄ 英文）" Tag="auto" />
                <ComboBoxItem Content="中文 → 英文" Tag="zh-en" />
                <ComboBoxItem Content="英文 → 中文" Tag="en-zh" />
            </ComboBox>
            <TextBlock Text="自动模式会根据识别出的文字判断翻译方向。" Style="{StaticResource HintText}" />

            <!-- 内容字体与字号，作用于原文及译文文本框 -->
            <TextBlock Text="内容字体" Style="{StaticResource FieldLabel}" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="FontFamilyBox"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          Height="30"
                          Margin="0,0,8,0"
                          VerticalContentAlignment="Center" />
                <ComboBox x:Name="FontSizeBox"
                          Grid.Column="1"
                          IsEditable="True"
                          Height="30"
                          VerticalContentAlignment="Center" />
            </Grid>
            <TextBlock Text="作用于识别内容与翻译结果区域。" Style="{StaticResource HintText}" />

            <!-- 开机启动选项 -->
            <TextBlock Text="启动" Style="{StaticResource FieldLabel}" />
            <CheckBox x:Name="AutoStartBox" Content="随系统启动（登录 Windows 后自动运行）" Margin="0,0,0,4" VerticalContentAlignment="Center" />
            <TextBlock Text="启动项写入当前用户注册表，可在任务管理器的“启动”中查看。" Style="{StaticResource HintText}" />

            <!-- 默认服务地址提示 -->
            <Border Background="#FFF7E6" CornerRadius="6" Padding="8,6" Margin="0,2,0,0">
                <TextBlock Text="提示：默认服务地址为 http://192.168.3.5:5000。LibreTranslate 需要加载 en 与 zh 模型；也可在项目根目录执行 docker compose up -d 启动本地服务。"
                           TextWrapping="Wrap"
                           Foreground="#92400E"
                           FontSize="10.5" />
            </Border>

            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" />

            <!-- 底部按钮：测试连接、保存、取消 -->
            <DockPanel Margin="0,12,0,0" LastChildFill="False">
                <Button x:Name="TestButton" Content="测试连接" Style="{StaticResource SecondaryButton}" Click="TestConnection_Click" DockPanel.Dock="Left" />
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Width="84" IsDefault="True" Margin="8,0,0,0" Click="Save_Click" DockPanel.Dock="Right" />
                <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="76" IsCancel="True" Margin="8,0,0,0" Click="Cancel_Click" DockPanel.Dock="Right" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
